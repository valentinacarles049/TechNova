# ==============================================================================
# TECHNOVA - ARCHIVO DE PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# HU-40: Conexión segura con el asistente virtual
# ==============================================================================
# Instrucciones:
# 1. Copia este archivo y renómbralo a ".env" en la raíz del proyecto.
# 2. Reemplaza los valores de ejemplo con tus credenciales reales.
# 3. Nunca subas el archivo ".env" al repositorio de Git.

# Clave de API de Google Gemini (Obtén la tuya en https://aistudio.google.com/)
GEMINI_API_KEY=tu_api_key_aqui

# Modelo de Google Gemini (predeterminado: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
